{
  "name": "woodz-archive",
  "version": "0.1.0",
  "private": true,
  "description": "WOODZ Archive y MOODZFLIX: sitio fan de WOODZ, estático, con el contenido en Google Sheets.",
  "type": "module",
  "scripts": {
    "build": "node tools/preparar.mjs && tailwindcss -i src/styles.css -o web/css/styles.css --minify",
    "dev:css": "tailwindcss -i src/styles.css -o web/css/styles.css --watch",
    "dev:web": "python3 -m http.server 5510 --directory web",
    "dev": "npm run build && (npm run dev:css & npm run dev:web)"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "tailwindcss": "^4.3.4"
  },
  "dependencies": {
    "papaparse": "^5.7.0"
  }
}
